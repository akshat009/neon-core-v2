# The game lives only at https://play.asaxenadev.com/.
# Redirect asaxenadev.com/play/* to play.asaxenadev.com/*
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?asaxenadev\.com$ [NC]
RewriteRule ^(.*)$ https://play.asaxenadev.com/$1 [R=301,L]
</IfModule>

# Always check for fresh HTML, JS, CSS and JSON. Hostinger CDN keeps static files at its
# edge for 2 hours when no Cache-Control is sent, and it served old racer JS/CSS even with a
# new ?v= on the link. "no-cache" makes the CDN and the browser revalidate with the server on
# every load (a cheap 304 when nothing changed). Images, fonts and audio keep normal caching.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|js|mjs|css|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Expires
    </FilesMatch>
</IfModule>

# Hostinger runs LiteSpeed: keep its server-side page cache off the HTML pages too
<IfModule LiteSpeed>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} (/|\.html?)$
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
